{
  "ConnectionStrings": {
    "Warehouse": "Data Source=warehouse.db"
  },
  "Jwt": {
    "Issuer": "WarehouseApi",
    "Audience": "WarehouseClients",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5288",
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

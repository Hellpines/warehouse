@page "/login"
@layout Layout.MainLayout
@inject WarehouseApiClient Api
@inject SessionPersistence Sessions
@inject NavigationManager Nav

<div class="login-screen">
    <section class="login-hero">
        <div class="login-hero-inner">
            <h1>Склад</h1>
            <p>Учёт товаров, поставок и остатков.</p>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <h2>Вход</h2>

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="field">
                    <label>Логин</label>
                    <InputText class="input" @bind-Value="_model.UserName" />
                    <ValidationMessage For="() => _model.UserName" />
                </div>
                <div class="field" style="margin-top:12px">
                    <label>Пароль</label>
                    <InputText type="password" class="input" @bind-Value="_model.Password" />
                    <ValidationMessage For="() => _model.Password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="error-text">@_error</p>
                }

                <div class="login-actions">
                    <button class="btn" type="submit" disabled="@_busy">
                        @(_busy ? "Вход…" : "Войти")
                    </button>
                </div>
            </EditForm>

            <div class="demo-note">
                manager / Manager123!<br />
                keeper / Keeper123!
            </div>
        </div>
    </section>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (await Sessions.TryRestoreAsync())
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model);
            if (result is null || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                _error = "Неверный логин или пароль.";
                return;
            }

            await Sessions.SaveAsync(new SessionInfo
            {
                AccessToken = result.AccessToken,
                UserName = result.UserName,
                Role = result.Role,
                DisplayName = result.DisplayName,
                ExpiresAtUtc = result.ExpiresAtUtc
            });
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = $"Нет связи с API: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}

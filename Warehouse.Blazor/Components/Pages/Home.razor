@page "/"
@attribute [Authorize]
@inject WarehouseApiClient Api
@inject SessionPersistence Sessions
@inject NavigationManager Nav

<PageTitle>Обзор — Склад</PageTitle>

<div class="page-head">
    <div>
        <h1>Обзор</h1>
        <p>Сводка по товарам, дефициту и поставкам.</p>
    </div>
</div>

@if (_loading)
{
    <p class="muted">Загрузка…</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <p class="error-text">@_error</p>
}
else
{
    <div class="stats">
        <div class="stat">
            <span class="muted">Товары</span>
            <strong>@_products</strong>
        </div>
        <div class="stat">
            <span class="muted">Низкий остаток</span>
            <strong>@_low</strong>
        </div>
        <div class="stat">
            <span class="muted">Поставки</span>
            <strong>@_deliveries</strong>
        </div>
    </div>

    <div class="panel">
        <div class="panel-pad">
            <h3 style="margin:0 0 8px;font-family:var(--font-display)">Низкий остаток</h3>
        </div>
        @if (_lowItems.Count == 0)
        {
            <div class="panel-pad"><p class="empty-note">Дефицита нет.</p></div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Артикул</th>
                        <th>Товар</th>
                        <th>Остаток</th>
                        <th>Мин.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _lowItems)
                    {
                        <tr>
                            <td>@s.Article</td>
                            <td>@s.Name</td>
                            <td><span class="badge badge-low">@s.Quantity @s.Unit</span></td>
                            <td>@s.MinStockLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private int _products;
    private int _low;
    private int _deliveries;
    private List<StockDto> _lowItems = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await Sessions.TryRestoreAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var products = await Api.GetProductsAsync();
            var stock = await Api.GetStockAsync(lowOnly: true);
            var deliveries = await Api.GetDeliveriesAsync();

            if (products is null || stock is null || deliveries is null)
            {
                _error = "Не удалось загрузить данные. Войдите снова.";
                await Sessions.ClearAsync();
                return;
            }

            _products = products.TotalCount;
            _low = stock.TotalCount;
            _deliveries = deliveries.TotalCount;
            _lowItems = stock.Items.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
